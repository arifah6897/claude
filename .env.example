# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Anthropic (Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Microsoft Outlook (Azure App Registration) ─────────
# Create at: https://portal.azure.com → App registrations
# Required permissions: Mail.Read, Mail.ReadWrite, offline_access
OUTLOOK_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OUTLOOK_TENANT_ID=common
# OUTLOOK_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # Use your tenant ID for work/school accounts
